# Vet Sambai Services — environment configuration
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or expose the service role key to the browser.

# Public (safe for browser) — from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used in server actions/route handlers, NEVER imported client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App metadata
NEXT_PUBLIC_APP_NAME="Vet Sambai Services"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage bucket used for animal photos (create this bucket in Supabase Storage)
NEXT_PUBLIC_SUPABASE_ANIMAL_PHOTOS_BUCKET=animal-photos

# --- Placeholders for future notification channels (not wired yet, see lib/notifications) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_BUSINESS_PHONE_ID=
# RESEND_API_KEY=
